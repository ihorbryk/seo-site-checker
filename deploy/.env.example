# Copy to .env next to compose.yaml and edit. Only VERSION and POSTGRES_PASSWORD
# are required.

# Release to run, without the leading "v" (e.g. 1.2.3). It pins every image,
# so the processes never run mismatched versions. There is no default.
VERSION=
# Password for the bundled Postgres. Pick a long random value.
POSTGRES_PASSWORD=

LOG_LEVEL=info
# Jobs one worker process runs at once.
WORKER_CONCURRENCY=20

# argon2id cost for password hashing.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_THREADS=1

# Registration is closed: Operators create Users with
# `docker compose run --rm -it operator /user create <email>`.
DENY_REGISTRATION=true
# INSECURE_COOKIES is deliberately not set, so session cookies are Secure.
# Serve the app over HTTPS through a reverse proxy.

# Only when upgrading an install that already has Projects (migration 00039):
# the existing Projects pass to a locked User with this email. A fresh install
# needs nothing.
BOOTSTRAP_EMAIL=

# Header holding the client IP behind your reverse proxy (e.g. X-Forwarded-For).
# Its rightmost entry keys the sign-in and registration rate limits. Set it
# ONLY if the proxy overwrites the header; otherwise clients can spoof it and
# dodge the rate limits.
# TRUSTED_PROXY_HEADER=X-Forwarded-For
